COMPOSE_PROJECT_NAME=daser-monitoring

# Runtime state stays outside the repository. Override this when you want a
# separate Prometheus/Grafana data directory.
DASER_MONITORING_DATA_ROOT=/data/zwt/daser_monitoring

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
